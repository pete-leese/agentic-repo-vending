# Example env — copy to .env and fill. Never commit .env.
GITHUB_TOKEN=
GITHUB_OWNER=pete-leese
# Status/label names used in the vend JSON plan (Atlassian tools apply them)
JIRA_BASE_URL=https://agentic-workflow-demo.atlassian.net
JIRA_IN_REVIEW_STATUS=In Review
JIRA_PROCESSING_STATUS=In Progress
JIRA_DONE_STATUS=Done
JIRA_APPROVED_LABEL=repo-vend-approved
JIRA_VENDED_LABEL=repo-vended
JIRA_LABEL_SUCCESS=repo-vend-success
JIRA_LABEL_WARNING=repo-vend-warning
JIRA_LABEL_ERROR=repo-vend-error
CURSOR_API_KEY=
ORCHESTRATOR_MODEL=composer-2.5
EVAL_MODEL=composer-2
ALLOW_LLM_FALLBACK=true
DRY_RUN=false
