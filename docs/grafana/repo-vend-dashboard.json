          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "(sum(increase({__name__=~\"repo_vend_vend_result(_total)?\", success=\"true\", phase=\"vend\"}[$__range])) or vector(0)) / clamp_min((sum(increase({__name__=~\"repo_vend_vend_result(_total)?\", success=\"true\", phase=\"propose\"}[$__range])) or vector(0)), 1)",
